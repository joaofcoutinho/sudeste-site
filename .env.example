# SMTP da Locaweb (E-mail Profissional)
# Opção A (SSL):  SMTP_HOST=email-ssl.com.br  | SMTP_PORT=465
# Opção B (TLS):  SMTP_HOST=smtplw.com.br     | SMTP_PORT=587
SMTP_HOST=email-ssl.com.br
SMTP_PORT=465

# A Locaweb exige que o remetente seja a MESMA conta que autentica.
SMTP_USER=gerencia@sudesteatacado.com.br
SMTP_PASS=sua-senha-do-email

# Para onde os leads do formulário serão enviados
LEAD_TO=gerencia@sudesteatacado.com.br
